#!/bin/bash
# Test entry point for {{app_name}} {{version}} on {{os_version}}
# This script is called by CI to run the shared test suite against a built image.

set -euo pipefail

APP_NAME="{{app_name}}"
APP_VERSION="{{version}}"
CONTAINER_NAME="oe-test-${APP_NAME}-${APP_VERSION}-$$"

# Cleanup on exit
trap 'docker rm -f "$CONTAINER_NAME" 2>/dev/null || true' EXIT

# Find the shared test suite
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TEST_DIR="$(cd "$SCRIPT_DIR/../../tests" && pwd)"

if [ ! -f "$TEST_DIR/goss.yaml" ]; then
    echo "ERROR: No shared test suite found at $TEST_DIR"
    exit 1
fi

# Run dgoss
export GOSS_FILE="$TEST_DIR/goss.yaml"
if [ -f "$TEST_DIR/goss_wait.yaml" ]; then
    export GOSS_WAIT="$TEST_DIR/goss_wait.yaml"
fi

dgoss run --name "$CONTAINER_NAME" "openeuler/${APP_NAME}:test"

echo "Tests passed for ${APP_NAME} ${APP_VERSION}"